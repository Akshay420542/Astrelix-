rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.uid == userId &&
        data.email is string &&
        data.email.size() <= 256;
    }

    function isValidSavedMission(data, userId) {
      return data.userId == userId &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 200;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Saved Orbital Missions
      match /savedMissions/{missionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(missionId) && isValidSavedMission(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(missionId) && isValidSavedMission(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(missionId);
      }
    }
  }
}
